@startuml
!pragma layout smetana
left to right direction

skinparam monochrome true
skinparam shadowing false
skinparam dpi 170
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 16
skinparam packageStyle rectangle

actor "Quản trị viên" as QuanTri

rectangle "Quản lý đơn hàng, khách hàng và thống kê (TV5)" {
  rectangle "Quản lý đơn hàng" {
    usecase "Xem danh sách\nđơn hàng" as UC1
    usecase "Lọc đơn hàng\ntheo trạng thái" as UC2
    usecase "Xem chi tiết\nđơn hàng" as UC3
    usecase "Cập nhật trạng thái\nđơn hàng" as UC4
    usecase "Hủy đơn hàng" as UC5
    usecase "Hoàn tồn kho" as UC6
  }
  rectangle "Quản lý khách hàng" {
    usecase "Xem danh sách\nkhách hàng" as UC7
    usecase "Tìm kiếm\nkhách hàng" as UC8
  }
  rectangle "Thống kê" {
    usecase "Xem thống kê\ndoanh thu theo tháng" as UC9
    usecase "Xem sản phẩm\nbán chạy" as UC10
  }
  usecase "Kiểm tra quyền quản trị\n(module TV1)" as UC11
}

QuanTri --> UC1
QuanTri --> UC2
QuanTri --> UC3
QuanTri --> UC4
QuanTri --> UC5
QuanTri --> UC7
QuanTri --> UC8
QuanTri --> UC9
QuanTri --> UC10

UC2 ..> UC1 : <<extend>>
UC3 ..> UC1 : <<extend>>
UC5 ..> UC6 : <<include>>
UC11 ..> UC1 : <<include>>
UC11 ..> UC2 : <<include>>
UC11 ..> UC3 : <<include>>
UC11 ..> UC4 : <<include>>
UC11 ..> UC5 : <<include>>
UC11 ..> UC7 : <<include>>
UC11 ..> UC8 : <<include>>
UC11 ..> UC9 : <<include>>
UC11 ..> UC10 : <<include>>
@enduml
